{
    "Começo do programa": {
        "scope": "python",
        "prefix": "programa",
        "body": ["from robo import *", "", "$0"],
        "description": "A primeira linha de todo programa do robô"
    },
    "Repetir sem parar": {
        "scope": "python",
        "prefix": "para_sempre",
        "body": ["with para_sempre():", "\t$0"],
        "description": "Repete sem parar o que estiver dentro"
    },
    "Repetir algumas vezes": {
        "scope": "python",
        "prefix": "repetir",
        "body": ["with repetir(${1:4}):", "\t$0"],
        "description": "Repete o que estiver dentro algumas vezes"
    },
    "Quadrado": {
        "scope": "python",
        "prefix": "quadrado",
        "body": ["with repetir(4):", "\tandar_cm(${1:30})", "\tvirar_direita(90)"],
        "description": "Anda em quadrado: 4 lados e 4 viradas de 90 graus"
    },
    "Se / senão com sensor": {
        "scope": "python",
        "prefix": "se_senao",
        "body": ["if luz_refletida(${1:1}) < limite(${1:1}):", "\t${2:bip()}", "else:", "\t$0"],
        "description": "Faz uma coisa se o sensor vê escuro e outra se vê claro"
    },
    "Enquanto": {
        "scope": "python",
        "prefix": "enquanto",
        "body": ["while ${1:distancia(4) > 15}:", "\t${2:motores(30, 30)}", "parar()"],
        "description": "Repete enquanto a condição for verdadeira e depois para"
    },
    "Andar até a linha": {
        "scope": "python",
        "prefix": "parar_na_linha",
        "body": ["while luz_refletida(${1:1}) > limite(${1:1}):", "\tmotores(${2:30}, ${2:30})", "parar()"],
        "description": "Anda até o sensor ver a linha preta e para"
    },
    "Desviar de obstáculo": {
        "scope": "python",
        "prefix": "desviar",
        "body": [
            "with para_sempre():",
            "\tif distancia(${1:4}) < ${2:20}:",
            "\t\tparar()",
            "\t\tre(rotacoes=0.5)",
            "\t\tvirar_direita(90)",
            "\telse:",
            "\t\tmotores(30, 30)"
        ],
        "description": "Anda e, quando chega perto de algo, dá ré e vira"
    },
    "Seguidor de linha com um sensor": {
        "scope": "python",
        "prefix": "seguidor_1_sensor",
        "body": [
            "# o sensor fica na borda da linha: no escuro vira para um lado, no claro para o outro",
            "with para_sempre():",
            "\tif luz_refletida(${1:1}) < limite(${1:1}):",
            "\t\tmotores(${2:10}, ${3:30})",
            "\telse:",
            "\t\tmotores(${3:30}, ${2:10})"
        ],
        "description": "Seguidor liga-desliga com um sensor na borda da linha"
    },
    "Seguidor de linha com dois sensores": {
        "scope": "python",
        "prefix": "seguidor_2_sensores",
        "body": [
            "# S1 à esquerda e S2 à direita da linha preta",
            "with para_sempre():",
            "\tif luz_refletida(${1:1}) < limite(${1:1}):",
            "\t\tmotores(${3:-15}, ${4:30})    # a linha foi para a esquerda",
            "\telif luz_refletida(${2:2}) < limite(${2:2}):",
            "\t\tmotores(${4:30}, ${3:-15})    # a linha foi para a direita",
            "\telse:",
            "\t\tmotores(${5:30}, ${5:30})    # a linha está no meio"
        ],
        "description": "Seguidor com um sensor de cada lado da linha"
    },
    "Seguidor proporcional": {
        "scope": "python",
        "prefix": "seguidor_proporcional",
        "body": [
            "KP = ${1:0.5}       # quanto ele corrige: aumente se perder as curvas",
            "VEL = ${2:25}       # velocidade na reta",
            "with para_sempre():",
            "\terro = luz_refletida(${3:1}) - limite(${3:1})",
            "\tmotores(VEL + erro * KP, VEL - erro * KP)"
        ],
        "description": "Seguidor que corrige mais quanto mais longe da borda da linha"
    },
    "Mostrar um sensor na tela": {
        "scope": "python",
        "prefix": "mostrar_sensor",
        "body": [
            "with para_sempre():",
            "\tmostrar('${1:Luz}:')",
            "\tmostrar(${2:luz_refletida(1)}, linha=2)",
            "\tesperar(0.1)"
        ],
        "description": "Mostra a leitura de um sensor na tela do robô, sem parar"
    },
    "Painel com valores": {
        "scope": "python",
        "prefix": "painel",
        "body": ["painel(${1:s1}=luz_refletida(${2:1}), ${3:s2}=luz_refletida(${4:2}))"],
        "description": "Mostra até 3 valores na tela do robô, com o nome na frente"
    },
    "Duas coisas ao mesmo tempo": {
        "scope": "python",
        "prefix": "ao_mesmo_tempo",
        "body": [
            "with ao_mesmo_tempo():",
            "\twith tarefa():",
            "\t\t${1:andar(segundos=2)}",
            "\twith tarefa():",
            "\t\t${2:melodia('do re mi fa sol')}"
        ],
        "description": "Faz duas partes do programa juntas, ex.: andar e tocar"
    },
    "Esperar um botão": {
        "scope": "python",
        "prefix": "esperar_botao",
        "body": ["mostrar('Aperte um botao')", "esperar_botao()", "$0"],
        "description": "Espera apertar e soltar um botão da controladora antes de começar"
    },
    "Contar com uma variável": {
        "scope": "python",
        "prefix": "contar",
        "body": [
            "guardar('${1:voltas}', 0)",
            "with repetir(${2:3}):",
            "\t${3:andar_cm(20)}",
            "\tguardar('${1:voltas}', ler('${1:voltas}') + 1)",
            "\tmostrar(ler('${1:voltas}'))"
        ],
        "description": "Guarda um número no robô e soma 1 a cada vez"
    },
    "Função": {
        "scope": "python",
        "prefix": "funcao",
        "body": ["def ${1:dancinha}():", "\t${2:virar_direita(90)}", "\t${3:virar_esquerda(90)}", "", "${1:dancinha}()"],
        "description": "Junta vários comandos com um nome, para usar várias vezes"
    }
}
