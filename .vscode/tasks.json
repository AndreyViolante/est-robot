{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Enviar para o Robô",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/enviar.py", "${file}"],
            "options": {"cwd": "${workspaceFolder}", "env": {"PYTHONIOENCODING": "utf-8"}},
            "group": {"kind": "build", "isDefault": true},
            "presentation": {"reveal": "always", "panel": "shared", "clear": true},
            "problemMatcher": []
        },
        {
            "label": "Gravar no robô sem executar",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/enviar.py", "${file}", "--so-gravar"],
            "options": {"cwd": "${workspaceFolder}", "env": {"PYTHONIOENCODING": "utf-8"}},
            "group": "build",
            "presentation": {"reveal": "always", "panel": "shared", "clear": true},
            "problemMatcher": []
        },
        {
            "label": "Simular no computador",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/simular.py", "${file}"],
            "options": {"cwd": "${workspaceFolder}", "env": {"PYTHONIOENCODING": "utf-8"}},
            "group": "build",
            "presentation": {"reveal": "always", "panel": "shared", "clear": true},
            "problemMatcher": []
        },
        {
            "label": "Só compilar (sem robô)",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/enviar.py", "${file}", "--so-compilar"],
            "options": {"cwd": "${workspaceFolder}", "env": {"PYTHONIOENCODING": "utf-8"}},
            "group": "build",
            "presentation": {"reveal": "always", "panel": "shared", "clear": true},
            "problemMatcher": []
        },
        {
            "label": "Testar conexão com o robô",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/ferramentas/testar_robo.py"],
            "options": {"cwd": "${workspaceFolder}", "env": {"PYTHONIOENCODING": "utf-8"}},
            "presentation": {"reveal": "always", "panel": "shared", "clear": true},
            "problemMatcher": []
        },
        {
            "label": "Conferir compilador com os gabaritos da IDE",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/verificar_gabaritos.py"],
            "options": {"cwd": "${workspaceFolder}", "env": {"PYTHONIOENCODING": "utf-8"}},
            "group": "test",
            "problemMatcher": []
        }
    ]
}
