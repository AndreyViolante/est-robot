{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Enviar para o Robô",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/enviar.py",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Só compilar (sem robô)",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/enviar.py",
                "${file}",
                "--so-compilar"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Conferir compilador com os gabaritos da IDE",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/verificar_gabaritos.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        }
    ]
}
