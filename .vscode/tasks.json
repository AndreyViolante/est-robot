{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Enviar para o Robô",
            "type": "shell",
            "command": "python",
            "windows": {"command": "${workspaceFolder}\\ferramentas\\rodar.cmd"},
            "args": ["${workspaceFolder}/enviar.py", "${file}"],
            "options": {"cwd": "${workspaceFolder}", "env": {"PYTHONIOENCODING": "utf-8"}},
            "group": {"kind": "build", "isDefault": true},
            "presentation": {"reveal": "always", "panel": "shared", "clear": true},
            "problemMatcher": []
        },
        {
            "label": "Gravar no robô sem executar",
            "type": "shell",
            "command": "python",
            "windows": {"command": "${workspaceFolder}\\ferramentas\\rodar.cmd"},
            "args": ["${workspaceFolder}/enviar.py", "${file}", "--so-gravar"],
            "options": {"cwd": "${workspaceFolder}", "env": {"PYTHONIOENCODING": "utf-8"}},
            "group": "build",
            "presentation": {"reveal": "always", "panel": "shared", "clear": true},
            "problemMatcher": []
        },
        {
